<form autocomplete="off" class="public-sheet-form">
    <div class="sheet-layout">
        
        <div class="sheet-sidebar">
            <div class="portrait-container" title="Click to expand image">
                <img src="{{actor.img}}" class="profile-img">
            </div>
            
            <h1 class="npc-name">{{actor.name}}</h1>
            
            <div class="faction-tag">{{faction}}</div>
            
            <div class="aff-badge-large {{affClass}}">
                {{affiliation}}
            </div>
        </div>

        <div class="sheet-main">
            
            <div class="notes-section">
                <h3><i class="fas fa-book-open"></i> Public Records</h3>
                <div class="bio-text">
                    {{#if bioPublic}}
                        {{bioPublic}}
                    {{else}}
                        <em style="color:#777;">No records on file.</em>
                    {{/if}}
                </div>
            </div>
            
            {{#if connections.length}}
            <hr>
            <div class="notes-section connections-section">
                <h3><i class="fas fa-network-wired"></i> Known Connections</h3>
                <div class="connections-grid">
                    {{#each connections}}
                    <div class="connection-item" data-id="{{id}}" title="Open {{name}}'s File">
                        <img src="{{img}}" class="conn-img">
                        <div class="conn-text">
                            <span class="conn-name">{{name}}</span>
                            <span class="conn-label">{{label}}</span>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/if}}

            <hr>

            <div class="notes-section party-notes-wrapper">
                <div class="notes-header">
                    <h3><i class="fas fa-users"></i> Party Notes</h3>
                    <button type="button" class="save-notes-btn" title="Force Save Notes"><i class="fas fa-save"></i> Save</button>
                </div>
                <textarea name="partyNotes" placeholder="Store your group's observations or thoughts here. Anyone in the party can see and edit this.">{{partyNotes}}</textarea>
            </div>

        </div>
    </div>
</form>

<style>
    .public-sheet-form { 
        height: 100%; 
        display: flex; 
        flex-direction: column; 
        box-sizing: border-box; 
    }
    
    .sheet-layout {
        display: flex;
        height: 100%;
        gap: 20px;
        background: #1c1b1a; 
        padding: 15px;
        box-sizing: border-box; 
    }


    .sheet-sidebar {
        flex: 0 0 250px;
        display: flex;
        flex-direction: column;
        align-items: center;
        border-right: 2px solid #5a5954; 
        padding-right: 20px;
    }

    .portrait-container {
        width: 100%;
        height: 250px;
        background: #000;
        border: 2px solid #4b4a44;
        border-radius: 5px;
        margin-bottom: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .profile-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border: none;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .profile-img:hover {
        transform: scale(1.05);
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    .npc-name {
        font-family: "Modesto Condensed", "Palatino Linotype", serif;
        font-size: 2em;
        text-align: center;
        border: none;
        margin: 0 0 10px 0;
        line-height: 1.1em;
        color: #e0e0e0; 
    }

    .faction-tag {
        font-size: 1.1em;
        font-weight: bold;
        color: #aaa; 
        margin-bottom: 15px;
        text-align: center;
    }


    .aff-badge-large {
        width: 100%;
        text-align: center;
        padding: 8px 0;
        border-radius: 4px;
        font-size: 1.2em;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
    }
    .aff-badge-large.allied { color: #2e8b57; background: #e0f8e0; border: 2px solid #2e8b57; }
    .aff-badge-large.friendly { color: #4682b4; background: #e6f2ff; border: 2px solid #4682b4; }
    .aff-badge-large.neutral { color: #555; background: #eee; border: 2px solid #ccc; }
    .aff-badge-large.dislike { color: #d2691e; background: #ffe6cc; border: 2px solid #d2691e; }
    .aff-badge-large.enemy { color: #8b0000; background: #ffcccc; border: 2px solid #8b0000; }
    .aff-badge-large.unknown { color: #555; background: #dbdbdb; border: 2px dashed #777; }


    .sheet-main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .notes-section {
        display: flex;
        flex-direction: column;
    }

    .notes-section h3 {
        border-bottom: 1px solid #5a5954;
        margin-top: 0;
        margin-bottom: 10px;
        padding-bottom: 5px;
        color: #e0e0e0; 
    }

    .bio-text {
        font-size: 1.1em;
        line-height: 1.4em;
        color: #ccc; 
        white-space: pre-wrap; 
        max-height: 200px;
        overflow-y: auto;
        padding-right: 10px;
    }


    .connections-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 5px;
    }

    .connection-item {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid #4b4a44;
        border-radius: 4px;
        padding: 5px;
        width: calc(50% - 5px);
        cursor: pointer;
        transition: background 0.2s, box-shadow 0.2s;
    }

    .connection-item:hover {
        background: #fff;
        box-shadow: 0 2px 5px rgba(0,0,0,0.5);
        border-color: #a8a69d;
    }

    .conn-img {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid #4b4a44;
        margin-right: 10px;
    }

    .conn-text {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .conn-name {
        font-weight: bold;
        color: #111;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.95em;
    }

    .conn-label {
        font-size: 0.8em;
        color: #555;
        font-style: italic;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sheet-main hr {
        border: 0;
        height: 2px;
        background: #5a5954;
        margin: 20px 0;
    }

    .party-notes-wrapper {
        flex: 1; 
        display: flex;
        flex-direction: column;
        min-height: 0; 
    }


    .notes-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 1px solid #5a5954;
        margin-bottom: 10px;
        padding-bottom: 5px;
    }
    
    .notes-header h3 {
        border: none;
        margin: 0;
        padding: 0;
    }


    .save-notes-btn {
        width: auto;
        padding: 4px 12px;
        background: rgba(255, 255, 255, 0.1);
        color: #e0e0e0;
        border: 1px solid #5a5954;
        border-radius: 3px;
        font-size: 0.85em;
        cursor: pointer;
        transition: all 0.2s;
    }

    .save-notes-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
        box-shadow: 0 0 5px rgba(255, 255, 255, 0.2);
    }

    .party-notes-wrapper textarea {
        width: 100%;
        flex: 1;
        resize: none;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid #4b4a44;
        padding: 10px;
        font-family: inherit;
        font-size: 1.1em;
        color: #111;
        box-sizing: border-box;
    }
    
    .party-notes-wrapper textarea:focus {
        background: #fff;
        outline: none;
        border-color: #a8a69d;
    }
</style>